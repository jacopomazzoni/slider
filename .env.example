# Copy to .env. Never commit real credentials or site content.
# New installs keep runtime data here. Absolute paths are also supported.
SLIDERCMS_DATA_DIR=data
SLIDERCMS_DEBUG=1
SLIDERCMS_ALLOWED_HOSTS=
# Public GitHub repository, without https://github.com/:
SLIDERCMS_UPDATE_REPOSITORY=
SLIDERCMS_UPDATE_BRANCH=main
# Enable only on a clean Git clone started by scripts/start_slidercms.sh.
SLIDERCMS_UPDATES_ENABLED=0

# Daily screen-power times use this timezone, independently of the OS timezone.
SLIDERCMS_TIME_ZONE=America/New_York
# For Pi 4 / multiple HDMI adapters, use the com port reported by cec-client -l.
# CEC_ADAPTER=/dev/cec0
CEC_TV_ADDRESS=0
CEC_TIMEOUT_SECONDS=20
CEC_RETRIES=3
CEC_POWER_ON_SETTLE_SECONDS=4
CEC_POWER_OFF_SETTLE_SECONDS=2
CEC_SEND_ACTIVE_SOURCE=1
# Optional TV input port override (not the Pi's HDMI connector index):
# CEC_HDMI_PORT=2
